  slug: string
  image: string
  alt: string
  title: string
  type: string
  transaction: "Prodej" | "Pronájem"
  location: string
  price: string
  gallery: { src: string; alt: string }[]
  highlights: string[]
  parameters: PropertyParameter[]
  description: string[]
}

