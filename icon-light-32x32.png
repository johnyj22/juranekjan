"use client"

import { useState, type FormEvent } from "react"
import { CheckCircle2, ChevronDown } from "lucide-react"

function FloatingInput({
  id,
  label,
  type = "text",
  required = true,
  inputMode,
}: {
  id: string
  label: string
  type?: string
  required?: boolean
  inputMode?: "text" | "tel" | "email" | "numeric"
}) {
  return (
    <div className="relative">
      <input
        id={id}
        name={id}
        type={type}
        inputMode={inputMode}
        required={required}
        placeholder=" "
        className="peer w-full rounded-md border border-border bg-background px-4 pb-2.5 pt-6 text-foreground outline-none transition-colors focus:border-brand focus:ring-2 focus:ring-brand/20"
      />
      <label
        htmlFor={id}
        className="pointer-events-none absolute left-4 top-4 text-sm text-muted-foreground transition-all peer-focus:top-2 peer-focus:text-xs peer-focus:text-brand peer-[:not(:placeholder-shown)]:top-2 peer-[:not(:placeholder-shown)]:text-xs"
      >
        {label}
      </label>
    </div>
  )
}

export function ValuationSection() {
  const [submitted, setSubmitted] = useState(false)

  function handleSubmit(e: FormEvent<HTMLFormElement>) {
    e.preventDefault()
    setSubmitted(true)
  }

  return (
    <section id="odhad" className="bg-[var(--secondary)] py-24 md:py-32">
      <div className="mx-auto grid max-w-6xl items-start gap-12 px-6 lg:grid-cols-2 lg:gap-16">
        <div className="lg:sticky lg:top-32">
          <p className="text-sm font-semibold uppercase tracking-[0.2em] text-brand">Odhad ceny</p>
          <h2 className="mt-4 text-balance font-heading text-3xl font-bold leading-tight tracking-tight text-foreground md:text-4xl">
            Získejte komplexní odborný odhad ceny
          </h2>
          <p className="mt-5 text-lg leading-relaxed text-muted-foreground">
            Nenechávejte hodnotu své nemovitosti náhodě. Do 24 hodin připravím analýzu z dat katastru
            a trhu.
          </p>
          <ul className="mt-8 space-y-3">
            {[
              "Analýza z dat katastru nemovitostí",
              "Technické posouzení stavu nemovitosti",
              "Nezávazně a zcela zdarma",
            ].map((item) => (
              <li key={item} className="flex items-center gap-3 text-muted-foreground">
                <CheckCircle2 className="h-5 w-5 shrink-0 text-brand" aria-hidden="true" />
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div className="rounded-2xl border border-border bg-card p-7 shadow-sm md:p-9">
          {submitted ? (
            <div className="flex flex-col items-center justify-center py-16 text-center">
              <CheckCircle2 className="h-14 w-14 text-brand" aria-hidden="true" />
              <h3 className="mt-5 font-heading text-2xl font-bold text-foreground">
                Děkuji za Vaši poptávku
              </h3>
              <p className="mt-3 max-w-sm leading-relaxed text-muted-foreground">
                Ozvu se Vám do 24 hodin s komplexní analýzou tržní ceny Vaší nemovitosti.
              </p>
            </div>
          ) : (
            <form onSubmit={handleSubmit} className="flex flex-col gap-4" noValidate>
              <FloatingInput id="jmeno" label="Jméno a příjmení" />
              <div className="grid gap-4 sm:grid-cols-2">
                <FloatingInput id="telefon" label="Telefon" type="tel" inputMode="tel" />
                <FloatingInput id="email" label="E-mail" type="email" inputMode="email" />
              </div>
              <FloatingInput id="adresa" label="Adresa nemovitosti" />
              <FloatingInput
                id="plocha"
                label="Užitná plocha (m²)"
                type="number"
                inputMode="numeric"
              />

              <div className="relative">
                <select
                  id="stav"
                  name="stav"
                  required
                  defaultValue=""
                  className="w-full appearance-none rounded-md border border-border bg-background px-4 py-4 text-foreground outline-none transition-colors focus:border-brand focus:ring-2 focus:ring-brand/20"
                >
                  <option value="" disabled>
                    Stav nemovitosti
                  </option>
                  <option value="0">0 – k rekonstrukci</option>
                  <option value="5">5 – dobrý stav, průměr</option>
                  <option value="10">10 – perfektní stav</option>
                </select>
                <ChevronDown
                  className="pointer-events-none absolute right-4 top-1/2 h-5 w-5 -translate-y-1/2 text-muted-foreground"
                  aria-hidden="true"
                />
              </div>

              <button
                type="submit"
                className="mt-2 inline-flex w-full items-center justify-center rounded-md bg-[var(--accent-red)] px-6 py-4 text-base font-semibold text-[var(--accent-red-foreground)] shadow-sm transition-colors hover:bg-[oklch(0.5_0.21_26)]"
              >
                Odeslat nezávaznou poptávku
              </button>
              <p className="text-center text-xs text-muted-foreground">
                Odesláním souhlasíte se zpracováním osobních údajů za účelem zpracování poptávky.
              </p>
            </form>
          )}
        </div>
      </div>
    </section>
  )
}
